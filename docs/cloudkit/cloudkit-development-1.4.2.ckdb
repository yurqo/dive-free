DEFINE SCHEMA

    RECORD TYPE CD_CustomMarkerRecord (
        CD_createdAt    TIMESTAMP QUERYABLE SORTABLE,
        CD_emoji        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_entityName   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_label        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_emoji_ckAsset  ASSET,
        CD_label_ckAsset  ASSET,
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_DiveRecord (
        CD_endTime        TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName     STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_maxDepthMeters DOUBLE QUERYABLE SORTABLE,
        CD_samples        BYTES QUERYABLE SORTABLE,
        CD_session        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_startTime      TIMESTAMP QUERYABLE SORTABLE,
        CD_samples_ckAsset  ASSET,
        "___createTime"   TIMESTAMP,
        "___createdBy"    REFERENCE,
        "___etag"         STRING,
        "___modTime"      TIMESTAMP,
        "___modifiedBy"   REFERENCE,
        "___recordID"     REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_MarkerRecord (
        CD_audioData     BYTES QUERYABLE SORTABLE,
        CD_audioFileName STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_emoji         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_entityName    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_kind          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_label         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_session       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_timestamp     TIMESTAMP QUERYABLE SORTABLE,
        CD_audioData_ckAsset      ASSET,
        CD_audioFileName_ckAsset  ASSET,
        CD_emoji_ckAsset          ASSET,
        CD_kind_ckAsset           ASSET,
        CD_label_ckAsset          ASSET,
        CD_summary                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_summary_ckAsset        ASSET,
        CD_text                   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_text_ckAsset           ASSET,
        CD_title                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_title_ckAsset          ASSET,
        CD_transcript             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_transcript_ckAsset     ASSET,
        "___createTime"  TIMESTAMP,
        "___createdBy"   REFERENCE,
        "___etag"        STRING,
        "___modTime"     TIMESTAMP,
        "___modifiedBy"  REFERENCE,
        "___recordID"    REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_PhotoRecord (
        CD_assetCloudIdentifier STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_assetIdentifier      STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_createdAt            TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_isVideo              INT64 QUERYABLE SORTABLE,
        CD_session              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_thumbnailData        BYTES QUERYABLE SORTABLE,
        CD_thumbnailFileName    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_assetCloudIdentifier_ckAsset  ASSET,
        CD_assetIdentifier_ckAsset       ASSET,
        CD_marker                        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_spot                          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_thumbnailData_ckAsset         ASSET,
        CD_thumbnailFileName_ckAsset     ASSET,
        "___createTime"         TIMESTAMP,
        "___createdBy"          REFERENCE,
        "___etag"               STRING,
        "___modTime"            TIMESTAMP,
        "___modifiedBy"         REFERENCE,
        "___recordID"           REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_SessionRecord (
        CD_activeEnergyKilocalories DOUBLE QUERYABLE SORTABLE,
        CD_airTemperatureCelsius    DOUBLE QUERYABLE SORTABLE,
        CD_currentRaw               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_endTime                  TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_heartRateSamples         BYTES QUERYABLE SORTABLE,
        CD_id                       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_latitude                 DOUBLE QUERYABLE SORTABLE,
        CD_locationName             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_locationNameEdited       INT64 QUERYABLE SORTABLE,
        CD_longitude                DOUBLE QUERYABLE SORTABLE,
        CD_notes                    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_photosAlbumIdentifier    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_rating                   INT64 QUERYABLE SORTABLE,
        CD_smoothTrack              INT64 QUERYABLE SORTABLE,
        CD_spot                     STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_startTime                TIMESTAMP QUERYABLE SORTABLE,
        CD_surfaceRaw               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_temperatureSamples       BYTES QUERYABLE SORTABLE,
        CD_title                    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_track                    BYTES QUERYABLE SORTABLE,
        CD_trip                     STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_visibilityRaw            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_waterTemperatureCelsius  DOUBLE QUERYABLE SORTABLE,
        CD_waveHeightMeters         DOUBLE QUERYABLE SORTABLE,
        CD_weatherCode              INT64 QUERYABLE SORTABLE,
        CD_weatherFetched           INT64 QUERYABLE SORTABLE,
        CD_windDirectionDegrees     DOUBLE QUERYABLE SORTABLE,
        CD_windSpeedKmh             DOUBLE QUERYABLE SORTABLE,
        CD_workoutUUID              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_currentRaw_ckAsset             ASSET,
        CD_heartRateSamples_ckAsset       ASSET,
        CD_locationName_ckAsset           ASSET,
        CD_notes_ckAsset                  ASSET,
        CD_photosAlbumIdentifier_ckAsset  ASSET,
        CD_surfaceRaw_ckAsset             ASSET,
        CD_temperatureSamples_ckAsset     ASSET,
        CD_tideRaw                        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_tideRaw_ckAsset                ASSET,
        CD_title_ckAsset                  ASSET,
        CD_track_ckAsset                  ASSET,
        CD_visibilityRaw_ckAsset          ASSET,
        "___createTime"             TIMESTAMP,
        "___createdBy"              REFERENCE,
        "___etag"                   STRING,
        "___modTime"                TIMESTAMP,
        "___modifiedBy"             REFERENCE,
        "___recordID"               REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_Spot (
        CD_centerLatitude         DOUBLE QUERYABLE SORTABLE,
        CD_centerLongitude        DOUBLE QUERYABLE SORTABLE,
        CD_country                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_countryCode            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_createdAt              TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                     STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_name                   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_photosFolderIdentifier STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_countryCode_ckAsset             ASSET,
        CD_country_ckAsset                 ASSET,
        CD_name_ckAsset                    ASSET,
        CD_notes                           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_notes_ckAsset                   ASSET,
        CD_photosFolderIdentifier_ckAsset  ASSET,
        "___createTime"           TIMESTAMP,
        "___createdBy"            REFERENCE,
        "___etag"                 STRING,
        "___modTime"              TIMESTAMP,
        "___modifiedBy"           REFERENCE,
        "___recordID"             REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_Trip (
        CD_createdAt    TIMESTAMP QUERYABLE SORTABLE,
        CD_endDate      TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_name         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_startDate    TIMESTAMP QUERYABLE SORTABLE,
        CD_name_ckAsset   ASSET,
        CD_notes          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_notes_ckAsset  ASSET,
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_NoteMutationRecord (
        CD_entityName       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_payload          BYTES QUERYABLE SORTABLE,
        CD_payload_ckAsset  ASSET,
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );
